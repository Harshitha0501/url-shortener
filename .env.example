# --- MySQL ---
MYSQL_URL=jdbc:mysql://localhost:3306/urlshortener?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USER=urlshortener
MYSQL_PASSWORD=urlshortener

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- App ---
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_CACHE_TTL_SECONDS=3600

# --- Rate limiting (per client IP, on POST /api/urls) ---
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_CAPACITY=20
APP_RATE_LIMIT_REFILL=20
APP_RATE_LIMIT_PERIOD=60

# --- GeoIP (optional, download GeoLite2-City.mmdb) ---
GEOIP_DB_PATH=

# --- Expiry cleanup cron (Spring cron: seconds minutes hours ...) ---
APP_EXPIRY_CRON=0 0 * * * *
